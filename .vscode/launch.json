{
  // Flavors are selected by entry point (lib/main_<flavor>.dart).
  // There are no native Android/iOS flavors, so do not pass --flavor.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "flutterMode": "debug"
    },
    {
      "name": "Staging (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "flutterMode": "debug"
    },
    {
      "name": "Staging (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "flutterMode": "profile"
    },
    {
      "name": "Prod (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "flutterMode": "debug"
    },
    {
      "name": "Prod (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "flutterMode": "release"
    }
  ]
}
